# REvoCompute demo playground — copy to .env.demo and edit the paths.
#
# This profile serves the canonical Task catalog and curated result replays but
# records no Task and executes nothing. It must use its own project name, state
# directories, port, session key, and Redis volume; never point these at a
# production deployment.
#
#   cp .env.demo.example /path/outside/the/checkout/.env.demo
#   chmod 0600 /path/outside/the/checkout/.env.demo
#   REVODESIGN_SERVER_ENV=/path/outside/the/checkout/.env.demo \
#     bash run/restart.sh setup
#
# `setup` generates REDIS_PASSWORD and AUTH_SECRET_KEY into the selected file.

COMPOSE_PROJECT_NAME=revocompute-demo
SERVER_IMAGE=revocompute-demo-server

# #REQ Dedicated demo state. Use a different parent from any production stack.
SERVER_DIR=/srv/revocompute-demo/server
LOG_DIR=/srv/revocompute-demo/logs
AUTH_DIR=/srv/revocompute-demo/auth

# #REQ First-start administrator. On an empty demo auth database the controller
# creates this account and prints its generated password once.
ADMIN_USERS=demo-admin

RUNNER_USERNAME=yinying
RUNNER_GROUP=yinying

# A distinct port and a loopback-only origin. Put TLS/authorization in front.
PORT=8082
GATEWAY_BIND=127.0.0.1
SERVER_BASE_URL=http://127.0.0.1:8082

ENABLE_REGISTER=false
AUTH_COOKIE_SECURE=false

# The demo profile: canonical manifests are advertised for inspection, every
# submission is refused, and no Slurm/Apptainer boundary is materialized.
REVOCOMPUTE_DEMO_MODE=true
REVOCOMPUTE_JOB_EXECUTOR=demo

# Empty selects every discovered family for preview. Nothing is executable here,
# so the selector only decides which Task manifests the browser can inspect.
ENABLED_TASKRUNNERS=

WORKER_CONCURRENCY=1
GUNICORN_WORKERS=2

# Optional build-time proxy used by restart.sh --use-proxy.
# REVODESIGN_BUILD_PROXY=http://127.0.0.1:63322
