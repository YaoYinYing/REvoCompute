Bootstrap: docker
From: python:3.12.11-slim-bookworm

%files
    python/tool_cli.py /opt/revocompute-tool/tool_cli.py

%post
    install -d -m 0755 /tool/input /tool/output /tool/scratch
    apt-get update
    apt-get install -y --no-install-recommends openbabel=3.1.1+dfsg-9+b3
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir rdkit==2026.3.6

%environment
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export MKL_NUM_THREADS=1
    export NUMEXPR_NUM_THREADS=1
    export HTTP_PROXY=
    export HTTPS_PROXY=
    export ALL_PROXY=

%test
    python3 /opt/revocompute-tool/tool_cli.py health

%startscript
    exec sleep infinity

%runscript
    exec python3 /opt/revocompute-tool/tool_cli.py "$@"
