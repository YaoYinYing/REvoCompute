+def _read_single_sequence_fasta(input_fasta_path: str) -> tuple[str, str]:
+  """Reads exactly one non-empty FASTA record, rejecting anything else."""
+  with open(input_fasta_path) as f:
+    input_fasta_str = f.read()
+  sequences, descriptions = parsers.parse_fasta(input_fasta_str)
+  if len(sequences) != 1:
+    raise ValueError(
+        f'--single_sequence requires exactly one FASTA record, found '
+        f'{len(sequences)} in {input_fasta_path}.')
+  if not sequences[0]:
+    raise ValueError(
+        f'--single_sequence requires a non-empty sequence in '
+        f'{input_fasta_path}.')
+  return sequences[0], descriptions[0]
+
+
+def query_only_feature_dict(input_fasta_path: str) -> Dict[str, Any]:
+  """Builds model features from one query sequence, without any search.
+
+  The sequence is the only MSA row (depth one) and no template features are
+  produced.  This is a genuine query-only inference mode, not an MSA-assisted
+  prediction with an emptied alignment.
+  """
+  input_sequence, input_description = _read_single_sequence_fasta(
+      input_fasta_path)
+  num_res = len(input_sequence)
+  return {
+      **pipeline.make_sequence_features(
+          sequence=input_sequence,
+          description=input_description,
+          num_res=num_res),
+      **pipeline.make_msa_features(
+          msas=[parsers.Msa(
+              sequences=[input_sequence],
+              deletion_matrix=[[0] * num_res],
+              descriptions=[input_description],
+          )]),
+  }
+
+
