Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

%files
    protenix/run.sh /app/revocompute/run.sh
    protenix/predict.py /app/revocompute/predict.py
    protenix/requirements.lock /opt/protenix-requirements.lock

%post
    rm -f /etc/apt/sources.list.d/cuda*.list
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates git kalign python3 python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache --require-hashes \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
        /opt/protenix-requirements.lock
    git init /opt/protenix
    git -C /opt/protenix remote add origin https://github.com/bytedance/Protenix.git
    git -C /opt/protenix fetch --depth 1 origin 2475421477ab414b571149ad4a875c390ff8a35d
    git -C /opt/protenix checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-build-isolation --no-cache --no-deps /opt/protenix
    rm -rf /opt/protenix/.git /opt/protenix-requirements.lock
    mkdir -p /mnt/db/weights/revocompute/protenix
    chmod +x /app/revocompute/run.sh /app/revocompute/predict.py

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/protenix
    export PROTENIX_ROOT_DIR=/mnt/db/weights/revocompute/protenix
    export PROTENIX_ASSET_ROOT=/mnt/db/weights/revocompute/protenix
    export LAYERNORM_TYPE=torch
    export XDG_CACHE_HOME=/tmp/protenix-cache
    export HF_HOME=/tmp/protenix-huggingface
    export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    python -c 'import cuequivariance_torch, rdkit, torch; from runner import batch_inference; assert torch.__version__.startswith("2.7.1"); assert torch.version.cuda == "12.8"'
    python /app/revocompute/predict.py --help >/dev/null
    command -v kalign >/dev/null
    test -d /opt/protenix
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
