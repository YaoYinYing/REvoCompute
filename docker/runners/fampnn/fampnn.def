Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%files
    fampnn/run.sh /app/revocompute/run.sh
    fampnn/normalize_score_table.py /app/revocompute/normalize_score_table.py
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3.10 python3.10-venv git build-essential
    rm -rf /var/lib/apt/lists/*
    python3.10 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    UV_HTTP_TIMEOUT=300 /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache \
      torch==2.4.1 torchvision==0.19.1 \
      numpy==2.2.6 scipy==1.15.2 gemmi==0.7.3 biopython==1.86 tqdm==4.67.1 \
      natsort==8.4.0 omegaconf==2.3.0 rdkit==2025.9.2 einops==0.8.1 \
      hydra-core==1.3.2 torchtyping==0.1.5 dm-tree==0.1.9 timm==1.0.22 \
      jaxtyping==0.3.3 joblib==1.5.2 pandas==2.3.3 torch-geometric==2.6.1 \
      --index-url https://download.pytorch.org/whl/cu121 \
      --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match
    git init /opt/fampnn
    git -C /opt/fampnn remote add origin https://github.com/richardshuai/fampnn.git
    git -C /opt/fampnn fetch --depth 1 origin aaf788b1502ad95d5c5a84455cfc53f2544f3b45
    git -C /opt/fampnn checkout --detach FETCH_HEAD
    rm -rf /opt/fampnn/.git /opt/fampnn/weights
    chmod +x /app/revocompute/run.sh

%environment
    export PATH=/opt/venv/bin:$PATH FAMPNN_PATH=/opt/fampnn PYTHONPATH=/opt/fampnn
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    PYTHONPATH=/opt/fampnn /opt/venv/bin/python -c 'import torch, torchvision, hydra, torch_geometric, fampnn; assert torch.__version__.startswith("2.4.1"); assert torch.version.cuda == "12.1"; assert torchvision.__version__.startswith("0.19.1")'
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
