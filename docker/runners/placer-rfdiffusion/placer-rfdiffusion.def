Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%files
    placer-rfdiffusion/rfdiffusion-bool-override.patch /tmp/rfdiffusion-bool-override.patch
    placer-rfdiffusion/run.sh /app/revocompute/run.sh
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git python3.10 python3.10-distutils python3-pip python3-openbabel patch
    rm -rf /var/lib/apt/lists/*
    git init /opt/PLACER
    git -C /opt/PLACER remote add origin https://github.com/YaoYinYing/PLACER.git
    git -C /opt/PLACER fetch --depth 1 origin 7dc5563300e7143582d85636bdd413d4c7688e9a
    git -C /opt/PLACER checkout --detach FETCH_HEAD
    rm -rf /opt/PLACER/.git
    git init /opt/RFdiffusion
    git -C /opt/RFdiffusion remote add origin https://github.com/RosettaCommons/RFdiffusion.git
    git -C /opt/RFdiffusion fetch --depth 1 origin 86507b6538f51fce57b5a72477165f03999ed7ae
    git -C /opt/RFdiffusion checkout --detach FETCH_HEAD
    rm -rf /opt/RFdiffusion/.git
    mkdir -p /opt/RFdiffusion/models
    patch -d /opt/RFdiffusion -p1 < /tmp/rfdiffusion-bool-override.patch
    rm /tmp/rfdiffusion-bool-override.patch
    python3 -m pip install --no-cache-dir uv
    uv pip install --system --no-cache --index-strategy unsafe-best-match torch==2.3.1 --extra-index-url https://download.pytorch.org/whl/cu121
    uv pip install --system --no-cache dgl==2.4.0 --find-links https://data.dgl.ai/wheels/torch-2.3/cu121/repo.html
    uv pip install --system --no-cache "e3nn @ https://github.com/e3nn/e3nn/archive/ef93f876c9985b3816aefb2982b3cf4325df6ba4.tar.gz" networkx==3.4.2 pandas==2.2.3 opt_einsum==3.4.0 hydra-core==1.3.2 pyrsistent==0.20.0
    chmod +x /app/revocompute/run.sh

%environment
    export PLACER_PATH=/opt/PLACER RFDIFFUSION_PATH=/opt/RFdiffusion
    export PYTHONPATH=/opt/RFdiffusion:/opt/RFdiffusion/env/SE3Transformer:$PYTHONPATH
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    python3 -c 'import dgl, e3nn, torch'
    test -d /opt/PLACER
    test -d /opt/RFdiffusion
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
