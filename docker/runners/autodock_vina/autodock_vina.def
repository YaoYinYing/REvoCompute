Bootstrap: docker
From: ubuntu:22.04
%files
    autodock_vina/run.sh /app/revocompute/run.sh
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py
%post
    set -e
    apt-get -o Acquire::Retries=10 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=10 install -y --no-install-recommends ca-certificates wget python3 python3-pip python3-venv openbabel
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache meeko==0.6.1 numpy==2.2.6 scipy==1.15.3 rdkit==2026.3.6 gemmi==0.7.5 Pillow==12.3.0
    wget -qO /usr/local/bin/vina https://github.com/ccsb-scripps/AutoDock-Vina/releases/download/v1.2.7/vina_1.2.7_linux_x86_64
    echo 'f31f774f723bba7bbe6e9d1c47577020eea9a8da16424284c043d22593570644  /usr/local/bin/vina' | sha256sum --strict --check
    chmod +x /usr/local/bin/vina /app/revocompute/run.sh
%environment
    export PATH=/opt/venv/bin:$PATH
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=
%test
    vina --version | grep -F '1.2.7'
    mk_prepare_receptor.py --help >/dev/null
    mk_prepare_ligand.py --help >/dev/null
    test -x /app/revocompute/run.sh
%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
