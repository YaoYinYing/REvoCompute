Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
%files
    gnina/run.sh /app/revocompute/run.sh
    gnina/normalize_results.py /app/revocompute/normalize_results.py
%post
    set -e
    rm -f /etc/apt/sources.list.d/cuda*.list
    apt-get -o Acquire::Retries=10 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=10 install -y --no-install-recommends ca-certificates wget
    rm -rf /var/lib/apt/lists/*
    wget -qO /usr/local/bin/gnina https://github.com/gnina/gnina/releases/download/v1.3.2/gnina.1.3.2.cuda12.8
    echo '714ef2928a22c7b20680ccfeade3c2a652a4e452a1f64343da541434528ed9cd  /usr/local/bin/gnina' | sha256sum --strict --check
    chmod +x /usr/local/bin/gnina /app/revocompute/run.sh /app/revocompute/normalize_results.py
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=
%test
    gnina --version | grep -F '1.3.2'
    python3 -c 'import py_compile; py_compile.compile("/app/revocompute/normalize_results.py", cfile="/tmp/normalize_results.pyc", doraise=True)'
    test -d /opt/revocompute/runtime

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
