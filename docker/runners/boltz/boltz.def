Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%files
    boltz/run.sh /app/revocompute/run.sh
    boltz/requirements.lock /opt/boltz-requirements.lock
    boltz/model-assets.sha256 /app/revocompute/model-assets.sha256
    boltz/upstream.json /app/revocompute/upstream.json
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    rm -f /etc/apt/sources.list.d/cuda*.list
    attempt=1
    until apt-get -o Acquire::Retries=5 update; do
      test "$attempt" -ge 10 && exit 1
      sleep $((attempt * 5))
      attempt=$((attempt + 1))
    done
    attempt=1
    until DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends python3.10 python3.10-venv git; do
      test "$attempt" -ge 10 && exit 1
      sleep $((attempt * 5))
      attempt=$((attempt + 1))
    done
    rm -rf /var/lib/apt/lists/*
    python3.10 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    UV_HTTP_TIMEOUT=300 /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache \
      --requirement /opt/boltz-requirements.lock \
      --index-url https://download.pytorch.org/whl/cu121 \
      --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match
    git init /opt/boltz
    git -C /opt/boltz remote add origin https://github.com/jwohlwend/boltz.git
    git -C /opt/boltz fetch --depth 1 origin 2355c62c957e95305527290112e9742d0565c458
    git -C /opt/boltz checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps /opt/boltz
    rm -rf /opt/boltz/.git
    chmod +x /app/revocompute/run.sh

%environment
    export PATH=/opt/venv/bin:$PATH
    export BOLTZ_CACHE=/mnt/db/boltz
    export PYTHONNOUSERSITE=1
    export WANDB_MODE=disabled
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    /opt/venv/bin/python -c 'import boltz, torch; assert torch.__version__.startswith("2.4.1"); assert torch.version.cuda == "12.1"'
    /opt/venv/bin/boltz --help >/dev/null
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
