Bootstrap: docker
From: nvidia/cuda:12.9.1-base-ubuntu24.04

%files
    freebindcraft/run.sh /app/revocompute/run.sh

%post
    apt-get update
    # FreeBindCraft's pinned Linux CUDA profile targets Python 3.12 with the
    # CUDA 12.9 pip wheels; the base image supplies no Python.
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential ca-certificates ffmpeg git libgfortran5 python3 python3-dev python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv
    # Upstream v1.0.7 source and its validated Linux CUDA environment manifest.
    git init /opt/bindcraft
    git -C /opt/bindcraft remote add origin https://github.com/cytokineking/FreeBindCraft.git
    git -C /opt/bindcraft fetch --depth 1 origin 8a10b93a9b42487e7218ad1435a6a25d0e91afc8
    git -C /opt/bindcraft checkout --detach FETCH_HEAD
    rm -rf /opt/bindcraft/.git
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache \
        --requirement /opt/bindcraft/installation/linux-cuda12-requirements.txt
    /opt/venv/bin/uv pip check --python /opt/venv/bin/python
    printf '%s\n' 8a10b93a9b42487e7218ad1435a6a25d0e91afc8 > /opt/bindcraft-source-commit
    chmod +x /opt/bindcraft/functions/dssp /opt/bindcraft/functions/sc /opt/bindcraft/functions/FASPR
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    export PATH=/opt/venv/bin:$PATH
    export BINDCRAFT_HOME=/opt/bindcraft OPENMM_PLATFORM_ORDER=CUDA OPENMM_DEFAULT_PLATFORM=CUDA JAX_PLATFORMS=cuda MPLCONFIGDIR=/tmp/matplotlib
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    python -c 'import colabdesign, jax, openmm; assert jax.__version__ == "0.11.2", jax.__version__; assert openmm.version.version.startswith("8.6.1"), openmm.version.version'
    grep -qx 8a10b93a9b42487e7218ad1435a6a25d0e91afc8 /opt/bindcraft-source-commit
    test -x /opt/bindcraft/functions/dssp
    test -x /app/revocompute/run.sh
    test -d /opt/revocompute/runtime

%labels
    org.revocompute.freebindcraft.commit 8a10b93a9b42487e7218ad1435a6a25d0e91afc8
    org.revocompute.freebindcraft.version 1.0.7

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
