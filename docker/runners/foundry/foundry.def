Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

%files
    foundry/run.sh /app/revocompute/run.sh
    foundry/launch.py /app/revocompute/launch.py
    foundry/validate_assets.py /app/revocompute/validate_assets.py
    foundry/checkpoint-registry.json /app/revocompute/checkpoint-registry.json
    foundry/upstream.json /app/revocompute/upstream.json
    foundry/requirements.lock /opt/foundry-requirements.lock

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' \
      /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates git python3 python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.13
    /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache --require-hashes \
      --index-url https://download.pytorch.org/whl/cu128 \
      --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
      /opt/foundry-requirements.lock
    git clone https://github.com/RosettaCommons/foundry.git /opt/foundry
    git -C /opt/foundry checkout --detach d078b24d6d0e6f8607e9a0311128f4a897f83953
    git -C /opt/foundry remote remove origin
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache \
      --no-build-isolation --no-deps /opt/foundry
    /opt/venv/bin/python -m pip check
    rm -rf /opt/foundry/.git /opt/foundry-requirements.lock /root/.cache
    chmod +x /app/revocompute/run.sh /app/revocompute/launch.py /app/revocompute/validate_assets.py
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime

%environment
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY=
    export http_proxy= https_proxy= all_proxy=
    export NO_PROXY= no_proxy=
    export PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export PYTHONNOUSERSITE=1
    export FOUNDRY_SOURCE_ROOT=/opt/foundry
    export FOUNDRY_UPSTREAM_MANIFEST=/app/revocompute/upstream.json
    export FOUNDRY_CHECKPOINT_DIRS=/mnt/db/weights/revocompute/foundry
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export WANDB_MODE=disabled

%runscript
    exec bash /app/revocompute/run.sh "$@"

%test
    test -x /app/revocompute/run.sh
    test -x /app/revocompute/launch.py
    test -x /app/revocompute/validate_assets.py
    test -f /app/revocompute/checkpoint-registry.json
    test -f /app/revocompute/upstream.json
    test -x /opt/venv/bin/rfd3
    test -x /opt/venv/bin/rfd3na
    test -x /opt/venv/bin/rf3
    /opt/venv/bin/python -c 'import atomworks, rf3, rfd3, rfd3na'
    /opt/venv/bin/python -m pip check
    test -d /opt/revocompute/runtime

%labels
    org.revocompute.foundry.commit d078b24d6d0e6f8607e9a0311128f4a897f83953
    org.revocompute.foundry.distribution rc-foundry==1.0.0
