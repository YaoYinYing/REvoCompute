Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%files
    geodock/run.sh /app/revocompute/run.sh
    geodock/launch.py /app/revocompute/launch.py
    geodock/predict.py /app/revocompute/predict.py
    geodock/requirements.lock /opt/geodock-requirements.lock
    geodock/model-assets.sha256 /app/revocompute/model-assets.sha256
    geodock/upstream.json /app/revocompute/upstream.json
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    rm -f /etc/apt/sources.list.d/cuda*.list
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' \
      /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      ca-certificates git python3 python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    UV_HTTP_TIMEOUT=300 /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache \
      --require-hashes --index-url https://download.pytorch.org/whl/cu118 \
      --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
      --find-links https://data.pyg.org/whl/torch-2.0.1+cu118.html /opt/geodock-requirements.lock
    git init /opt/geodock
    git -C /opt/geodock remote add origin https://github.com/Graylab/GeoDock.git
    git -C /opt/geodock fetch --depth 1 origin df8d1f4c24ae2946655f27e7411ba2ffabf3d350
    git -C /opt/geodock checkout --detach FETCH_HEAD
    echo "4a323ebaba152285a2444dcbf68de2dba7ec77f7d61a6d8b693c75169900d162  /opt/geodock/geodock/weights/dips_0.3.ckpt" | sha256sum --strict --check
    rm /opt/geodock/geodock/weights/dips_0.3.ckpt
    git init /opt/pdbfixer
    git -C /opt/pdbfixer remote add origin https://github.com/openmm/pdbfixer.git
    git -C /opt/pdbfixer fetch --depth 1 origin 6bf10e138f6475f6f1850dae78d7bf1b420a1612
    git -C /opt/pdbfixer checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps /opt/pdbfixer
    rm -rf /opt/geodock/.git /opt/pdbfixer /opt/geodock-requirements.lock
    chmod +x /app/revocompute/run.sh /app/revocompute/launch.py /app/revocompute/predict.py

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/geodock
    export GEODOCK_SOURCE_ROOT=/opt/geodock
    export PYTHONNOUSERSITE=1
    export TORCH_HOME=/nonexistent/geodock-offline
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    /opt/venv/bin/python -c 'import esm, openmm, pdbfixer, torch, torch_geometric; import geodock; assert torch.__version__.startswith("2.0.1"); assert torch.version.cuda == "11.8"'
    test -f /opt/geodock/geodock/model/GeoDock.py
    test ! -e /opt/geodock/geodock/weights/dips_0.3.ckpt
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
