Bootstrap: docker
From: ubuntu:22.04

%files
    molprobity/run.sh /app/revocompute/run.sh
    molprobity/validate.py /app/revocompute/validate.py
    molprobity/model-assets.sha256 /app/revocompute/model-assets.sha256
    molprobity/upstream.json /app/revocompute/upstream.json
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    set -e
    # Keep the distributor's plain-HTTP archive URLs: the build proxy terminates
    # TLS with a CA the base image does not trust, so rewriting to https fails.
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      ca-certificates python3 python3-venv
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache \
      cctbx-base==2025.11
    mkdir -p /opt/molprobity
    cp /opt/venv/lib/python*/site-packages/cctbx/LICENSE_2_0.txt /opt/molprobity/LICENSE.txt
    cp /opt/venv/lib/python*/site-packages/mmtbx/probe/LICENSE /opt/molprobity/probe-LICENSE.txt
    mkdir -p /opt/molprobity/reference-licenses
    printf 'rotarama_data: CC-BY-4.0 https://github.com/rlabduke/reference_data/blob/master/LICENSE\n' \
      > /opt/molprobity/reference-licenses/rotarama_data.txt
    printf 'geostd: BSD-3-Clause-LBNL https://github.com/phenix-project/geostd/blob/master/LICENSE.txt\n' \
      > /opt/molprobity/reference-licenses/geostd.txt
    # libtbx resolves chem_data/rotarama_data through its environment's
    # repository paths, which include the virtual-environment prefix. Pointing
    # that one path at the read-only runtime mount avoids a second copy of the
    # reference data in the image while keeping both resolvers working.
    rm -rf /opt/venv/chem_data
    ln -s /mnt/db/weights/revocompute/molprobity/chem_data /opt/venv/chem_data
    chmod +x /app/revocompute/run.sh /app/revocompute/validate.py

%environment
    export PATH=/opt/venv/bin:$PATH
    export MOLPROBITY_ASSET_ROOT=/mnt/db/weights/revocompute/molprobity
    export MOLPROBITY_ASSET_MANIFEST=/app/revocompute/model-assets.sha256
    export PYTHONNOUSERSITE=1
    export TMPDIR=/tmp
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    # Validate the analyses in the order the adapter imports them. Importing
    # rdkit before mmtbx segfaults in this combination, and the adapter never
    # imports rdkit, so it stays out of the image entirely.
    /opt/venv/bin/python -c 'import mmtbx, iotbx; from mmtbx.validation.molprobity import molprobity; from mmtbx.validation.utils import molprobity_score; print(mmtbx.__version__)'
    for analysis in ramalyze rotalyze cbetadev omegalyze clashscore2; do command -v "molprobity.$analysis" >/dev/null; done
    test -x /app/revocompute/run.sh
    /opt/venv/bin/python -c 'import ast, pathlib; ast.parse(pathlib.Path("/app/revocompute/validate.py").read_text())'
    test -s /opt/molprobity/LICENSE.txt

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
