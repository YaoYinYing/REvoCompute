Bootstrap: docker
From: condaforge/mambaforge:24.9.2-0

%files
    pssm_gremlin/GREMLIN.yml /GREMLIN.yml
    pssm_gremlin/scripts /app/revocompute/scripts
    pssm_gremlin/run.sh /app/revocompute/run.sh

%post
    conda env create -f /GREMLIN.yml
    conda clean --all --force-pkgs-dirs --yes
    rm -f /GREMLIN.yml
    chmod -R a+rX /app/revocompute
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    export PATH="/opt/conda/envs/GREMLIN/bin:/opt/conda/bin:$PATH"
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=
    export HTTP_PROXY=""
    export HTTPS_PROXY=""
    export ALL_PROXY=""
    export http_proxy=""
    export https_proxy=""
    export all_proxy=""
    export NO_PROXY=""
    export no_proxy=""

%test
    test -x /opt/conda/envs/GREMLIN/bin/python
    test -x /opt/conda/envs/GREMLIN/bin/hhblits
    test -x /opt/conda/envs/GREMLIN/bin/psiblast
    /opt/conda/envs/GREMLIN/bin/python -c "import Bio, numpy, pandas, scipy, tensorflow"
    test -x /app/revocompute/run.sh
    test -d /opt/revocompute/runtime

%runscript
    exec bash /app/revocompute/run.sh "$@"
