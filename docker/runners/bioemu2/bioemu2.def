Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

%files
    bioemu2/requirements.lock /opt/bioemu2-requirements.lock

%post
    # Fail on the first broken step: Apptainer reports only the section's last
    # command, so a failed install would otherwise leave a green build.
    set -e
    apt-get update
    # Triton compiles a CUDA-utils module in-process on its first kernel launch,
    # so it needs a C compiler and the Python headers; the CUDA runtime base
    # image ships neither. Only sequences past cuEquivariance's 100-residue
    # fallback threshold reach a Triton kernel and therefore this build path.
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates git python3 python3-venv gcc libc6-dev python3-dev
    rm -rf /var/lib/apt/lists/*
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    # BioEmu2's CUDA 12 extra: torch 2.13.0+cu126 and the cu12 cuEquivariance
    # kernels, so the base image and the wheels share the CUDA 12.6 minor.
    /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache \
        --require-hashes \
        --index-url https://download.pytorch.org/whl/cu126 \
        --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
        /opt/bioemu2-requirements.lock
    rm -f /opt/bioemu2-requirements.lock
    # The installed package is the exact upstream source commit, not the older
    # v0.1.0rc0 wheel; its dependency closure comes from requirements.lock.
    git init /opt/bioemu2-src
    git -C /opt/bioemu2-src remote add origin https://github.com/microsoft/bioemu2.git
    git -C /opt/bioemu2-src fetch --depth 1 origin 6d1ca744fa8ed285edafae7b98da65205bf00fd3
    git -C /opt/bioemu2-src checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps /opt/bioemu2-src
    printf '%s\n' 6d1ca744fa8ed285edafae7b98da65205bf00fd3 > /opt/bioemu2-source-commit
    rm -rf /opt/bioemu2-src/.git
    # Reserved Runtime Bundle mount point. This image is the *environment*;
    # REvoCompute's entrypoint and adapter arrive at execution time as a
    # read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    # Importing bioemu2 creates two caches eagerly: cuequivariance's Triton cache
    # resolves through HOME when CUEQ_TRITON_CACHE_DIR is unset, and numba's
    # cache needs a writable locator (its in-tree locator is unusable in a
    # read-only image). HOME under --containall is a 64 MiB private tmpfs, too
    # small for compiled caches, so keep both in the container-local /tmp, which
    # is writable and discarded with the job.
    export PATH=/opt/venv/bin:$PATH
    export CUEQ_TRITON_CACHE_DIR=/tmp/cuequivariance-triton
    export NUMBA_CACHE_DIR=/tmp/numba-cache
    export BIOEMU2_CHECKPOINT_ROOT=/mnt/db/weights/bioemu2/checkpoints/bioemu2-preview
    export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    # Fail on the first broken check: without this, a failed import is masked by
    # the later `test` commands and %test proves nothing.
    set -e
    # Environment validity only: the CUDA/PyTorch ABI and the pinned upstream
    # package. REvoCompute overlay modules are deliberately absent from the
    # image, so importing them here would test the wrong artifact. %test
    # inherits %environment, so the cache redirects apply here too.
    python -c 'import torch, bioemu2; assert torch.__version__ == "2.13.0+cu126", torch.__version__; assert torch.version.cuda == "12.6"'
    # The Triton build path that long sequences take needs both at execution time.
    python -c 'import os, shutil, sysconfig; assert shutil.which("cc") and os.path.exists(os.path.join(sysconfig.get_paths()["include"], "Python.h"))'
    # The image must prove it installed the source commit, not the release wheel.
    grep -qx 6d1ca744fa8ed285edafae7b98da65205bf00fd3 /opt/bioemu2-source-commit
    test -d /opt/revocompute/runtime
    test ! -e /app/revocompute

%labels
    org.revocompute.bioemu2.commit 6d1ca744fa8ed285edafae7b98da65205bf00fd3
    org.revocompute.bioemu2.version 0.1.0rc0
