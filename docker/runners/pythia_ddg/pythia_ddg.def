Bootstrap: docker
From: python:3.12-slim

%files
    pythia_ddg/run.sh /app/revocompute/run.sh

%post
    apt-get update
    apt-get install -y --no-install-recommends git
    git init /opt/pythia
    git -C /opt/pythia remote add origin https://github.com/YaoYinYing/Pythia.git
    git -C /opt/pythia fetch --depth 1 origin 9c3d4b29d0c9d73cfd33fc33da43ae316ef6224f
    git -C /opt/pythia checkout --detach FETCH_HEAD
    rm -rf /opt/pythia/.git /var/lib/apt/lists/*
    python -m pip install --no-cache-dir uv
    uv pip install --system --no-cache --index-strategy unsafe-best-match torch --extra-index-url https://download.pytorch.org/whl/cpu
    uv pip install --system --no-cache biopython joblib numpy pandas pytorch_lightning scipy torchmetrics tqdm
    ln -s /opt/pythia/pythia /app/revocompute/pythia
    ln -s /opt/pythia/pythia-c.pt /app/revocompute/pythia-c.pt
    ln -s /opt/pythia/pythia-p.pt /app/revocompute/pythia-p.pt
    chmod +x /app/revocompute/run.sh
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    python -c 'import Bio, torch; import sys; sys.path.insert(0, "/opt/pythia")'
    test -f /opt/pythia/pythia-c.pt
    test -d /opt/revocompute/runtime

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
