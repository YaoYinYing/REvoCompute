Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

%files
    ppiformer/run.sh /app/revocompute/run.sh
    ppiformer/predict.py /app/revocompute/predict.py
    ppiformer/requirements.lock /opt/ppiformer-requirements.lock
    ppiformer/model-assets.sha256 /app/revocompute/model-assets.sha256
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    rm -f /etc/apt/sources.list.d/cuda*.list
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates git python3.10 python3.10-venv
    rm -rf /var/lib/apt/lists/*
    python3.10 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    UV_HTTP_TIMEOUT=300 /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache \
        --require-hashes --index-url https://download.pytorch.org/whl/cu118 \
        --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
        /opt/ppiformer-requirements.lock

    # The vendored Equiformer project invokes setuptools' wheel command while
    # installing from its pinned source checkout.
    /opt/venv/bin/python -m pip install --no-cache-dir --no-deps wheel==0.45.1

    git init /opt/equiformer-pytorch
    git -C /opt/equiformer-pytorch remote add origin https://github.com/anton-bushuiev/equiformer-pytorch.git
    git -C /opt/equiformer-pytorch fetch --depth 1 origin 2a81808b72a6efc8ff1c809c0cc9d5b7cc0de386
    git -C /opt/equiformer-pytorch checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --no-build-isolation /opt/equiformer-pytorch

    git init /opt/mutils
    git -C /opt/mutils remote add origin https://github.com/anton-bushuiev/mutils.git
    git -C /opt/mutils fetch --depth 1 origin c3b99888c325c706a79371c084b066e6793edcbd
    git -C /opt/mutils checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --no-build-isolation /opt/mutils

    git init /opt/PPIRef
    git -C /opt/PPIRef remote add origin https://github.com/anton-bushuiev/PPIRef.git
    git -C /opt/PPIRef fetch --depth 1 origin a2a5b6d01f958acac39418bda1a5a9e3b4d71b53
    git -C /opt/PPIRef checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --no-build-isolation /opt/PPIRef

    git init /opt/PPIformer
    git -C /opt/PPIformer remote add origin https://github.com/anton-bushuiev/PPIformer.git
    git -C /opt/PPIformer fetch --depth 1 origin e324f5f30dd0dae55d194ac6b4d18c772219c3ee
    git -C /opt/PPIformer checkout --detach FETCH_HEAD
    /opt/venv/bin/uv pip install --python /opt/venv/bin/python --no-cache --no-deps \
        --no-build-isolation /opt/PPIformer

    rm -rf /opt/PPIformer/.git /opt/equiformer-pytorch/.git /opt/mutils/.git /opt/PPIRef/.git
    rm -f /opt/ppiformer-requirements.lock
    chmod -R a+rX /opt/PPIformer /app/revocompute
    chmod +x /app/revocompute/run.sh /app/revocompute/predict.py

%environment
    export PATH=/opt/venv/bin:$PATH
    export PPIFORMER_ASSET_ROOT=/mnt/db/weights/revocompute/ppiformer
    export XDG_CACHE_HOME=/tmp/ppiformer-cache
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export WANDB_MODE=disabled
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    /opt/venv/bin/python -c 'import torch, torch_geometric, ppiformer; assert torch.__version__ == "2.1.2+cu118"'
    /opt/venv/bin/python /app/revocompute/predict.py --help >/dev/null
    test ! -e /opt/PPIformer/weights
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
