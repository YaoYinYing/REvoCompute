Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

%files
    rfdiffusion2/run.sh /app/revocompute/run.sh
    rfdiffusion2/launch.py /app/revocompute/launch.py
    rfdiffusion2/requirements.lock /opt/rfdiffusion2-requirements.lock
    rfdiffusion2/model-assets.sha256 /app/revocompute/model-assets.sha256
    rfdiffusion2/upstream.json /app/revocompute/upstream.json
    common/verify_model_asset.sh /app/revocompute/verify_model_asset.sh
    common/task_context.sh /app/revocompute/task_context.sh
    common/task_context.py /app/revocompute/task_context.py

%post
    rm -f /etc/apt/sources.list.d/cuda*.list
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' \
      /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      ca-certificates git software-properties-common libxrender1 libxext6
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get -o Acquire::Retries=5 update
    DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      python3.11 python3.11-venv
    rm -rf /var/lib/apt/lists/*
    python3.11 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir uv==0.8.22
    UV_HTTP_TIMEOUT=300 /opt/venv/bin/uv pip sync --python /opt/venv/bin/python --no-cache \
      --require-hashes \
      --index-url https://download.pytorch.org/whl/cu121 \
      --extra-index-url https://pypi.org/simple --index-strategy unsafe-best-match \
      --find-links https://data.dgl.ai/wheels/torch-2.4/cu121/repo.html \
      /opt/rfdiffusion2-requirements.lock
    git init /opt/rfdiffusion2
    git -C /opt/rfdiffusion2 remote add origin https://github.com/RosettaCommons/RFdiffusion2.git
    git -C /opt/rfdiffusion2 fetch --depth 1 origin d365cbf4db3958814a9f8e4f6f94fa309dfebc2b
    git -C /opt/rfdiffusion2 checkout --detach FETCH_HEAD
    # Chai Discovery code is separately restricted and is not part of the
    # supported RFdiffusion2 execution path. Keep it out of the runtime.
    rm -rf /opt/rfdiffusion2/lib/chai
    rm -rf /opt/rfdiffusion2/.git /opt/rfdiffusion2-requirements.lock
    chmod +x /app/revocompute/run.sh /app/revocompute/launch.py /app/revocompute/verify_model_asset.sh

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/opt/rfdiffusion2
    export RFDIFFUSION2_SOURCE_ROOT=/opt/rfdiffusion2
    export PYTHONNOUSERSITE=1
    export DGLBACKEND=pytorch
    export WANDB_MODE=disabled
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    set -e
    DGLBACKEND=pytorch /opt/venv/bin/python -c 'import dgl, openbabel, torch; import rf_diffusion.run_inference; assert torch.__version__.startswith("2.4.0"); assert torch.version.cuda == "12.1"'
    test -f /opt/rfdiffusion2/rf_diffusion/run_inference.py
    test ! -e /opt/rfdiffusion2/lib/chai
    test "$DGLBACKEND" = pytorch
    test -x /app/revocompute/run.sh

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
