Bootstrap: docker
From: python:3.11-slim

%files
    bioemu/constraints.txt /opt/bioemu-constraints.txt
    bioemu/run.sh /app/revocompute/run.sh

%post
    ln -fs /usr/share/zoneinfo/Etc/UTC /etc/localtime
    echo Etc/UTC > /etc/timezone
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends kalign
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir uv
    uv pip install --system --no-cache --index-strategy unsafe-best-match "torch==2.7.1" --extra-index-url https://download.pytorch.org/whl/cu128
    uv pip install --system --no-cache --constraint /opt/bioemu-constraints.txt "jax[cuda12]==0.5.3" "bioemu[cuda]==1.4.1"
    rm /opt/bioemu-constraints.txt
    chmod +x /app/revocompute/run.sh
    # Reserved Runtime Bundle mount point.  This image is the *environment*;
    # REvoCompute's entrypoint and shared runtime helpers arrive at execution
    # time as a read-only bundle mounted here.
    mkdir -p /opt/revocompute/runtime
    chmod 0555 /opt/revocompute/runtime

%environment
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= NO_PROXY= no_proxy=

%test
    python -c 'import bioemu, jax, torch'
    test -d /opt/revocompute/runtime

%runscript
    exec /bin/bash /app/revocompute/run.sh "$@"
