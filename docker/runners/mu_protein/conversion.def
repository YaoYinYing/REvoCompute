Bootstrap: docker
From: python:3.11.9-slim-bookworm

%files
    mu_protein/convert_checkpoint.py /opt/mu_protein/convert_checkpoint.py
    mu_protein/asset-registry.json /opt/mu_protein/asset-registry.json
    mu_protein/requirements.lock /opt/mu_protein-requirements.lock

%post
    set -eux
    python -m pip install --no-cache-dir --index-url https://pypi.org/simple uv==0.8.22
    python -m venv /opt/venv
    uv pip sync --python /opt/venv/bin/python --no-cache --require-hashes \
        --index-url https://pypi.org/simple \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        --index-strategy unsafe-best-match \
        /opt/mu_protein-requirements.lock
    rm -f /opt/mu_protein-requirements.lock
    chmod +x /opt/mu_protein/convert_checkpoint.py

%environment
    export PATH=/opt/venv/bin:$PATH
    export HTTP_PROXY= HTTPS_PROXY= ALL_PROXY=
    export http_proxy= https_proxy= all_proxy=
    export NO_PROXY= no_proxy=
    export PYTHONNOUSERSITE=1

%runscript
    exec python /opt/mu_protein/convert_checkpoint.py "$@"

%test
    test -x /opt/mu_protein/convert_checkpoint.py
    test -f /opt/mu_protein/asset-registry.json
    /opt/venv/bin/python -c 'import numpy, safetensors, torch; assert numpy.__version__ == "1.26.4"; assert safetensors.__version__ == "0.4.5"; assert torch.__version__ == "2.4.0+cpu"'
