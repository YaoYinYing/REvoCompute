worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_max_body_size 16m;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    # Response compression is negotiated at the deployed gateway so the
    # application continues to serve exact identity bytes and never has to
    # enforce a decoded limit for a response.  The allowlist is text-like
    # only: archives, images, binary structure containers and
    # application/octet-stream never match, so XTC/DCD/ZIP and already
    # compressed bytes pass through unchanged.  nginx does not compress a 206
    # Partial Content response, so a byte-exact range download survives the
    # proxy; gzip_vary preserves the negotiated representation in caches and
    # nginx weakens an upstream strong ETag to a weak validator when it
    # rewrites the body, so a conditional client never matches the wrong one.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        application/json
        application/manifest+json
        application/xml
        application/javascript
        text/css
        text/plain
        text/javascript
        text/x-a3m
        text/x-fasta
        text/csv
        text/tab-separated-values
        image/svg+xml
        chemical/x-pdb
        chemical/x-cif
        chemical/x-mmcif
        chemical/x-gro;

    # Password-reset and email-verification links carry their one-time token in
    # the ``c=`` query parameter.  The default access log would persist it
    # verbatim, so a request bearing one is not logged.
    map $arg_c $loggable {
        default 0;   # token present — do not log this request line
        ""      1;
    }

    # Artifact-scoped download links carry their bearer token as a path
    # segment.  These requests stay in the access log for operational
    # visibility, but the request line is rewritten for the log only.  Matching
    # the raw ``$request`` catches double-encoded separators (``%252F``) and a
    # trailing encoded NUL; matching the normalized ``$uri`` catches
    # percent-encoded marker letters and collapsed slashes and dot segments.
    # Every other request keeps its original line.
    map $request $log_raw_marker {
        default 0;
        ~*artifact-downloads 1;
        ~*%25 1;   # double-encoded byte — a marker letter may be hidden
        ~*%00 1;   # encoded NUL terminator
    }
    map $uri $log_normalized_marker {
        default 0;
        ~*artifact-downloads 1;
        ~*% 1;     # nginx decoded ``%25`` to ``%``; the marker may be hidden
    }
    map "$log_raw_marker$log_normalized_marker" $log_request {
        default $request;
        ~1 "$request_method /compute/api/artifact-downloads/[redacted] $server_protocol";
    }
    log_format revocompute_combined '$remote_addr - $remote_user [$time_local] "$log_request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';
    access_log /dev/stdout revocompute_combined if=$loggable;

    map $http_x_forwarded_proto $origin_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    server {
        listen 8080;
        server_name _;
        error_page 503 =503 /maintenance.html;

        # A parent-dot segment can normalize the bearer marker out of ``$uri``
        # while the raw request line still names the token.  Locations and
        # ``error_log`` cannot match the raw line, so reject such a URI before
        # any upstream can log it.  No legitimate request needs a ``..``
        # segment; separators may be raw or percent-encoded.
        if ($request_uri ~* "(^|/|%2f)(\.|%2e){2}(/|%2f|$)") {
            return 400;
        }

        location / {
            if (-f /srv/deployment/.maintenance) { return 503; }
            proxy_pass http://web:${UPSTREAM_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $origin_proto;
        }

        # Bearer download links are the one route whose URL names a secret.
        # The access log redacts it, but nginx error messages (an upstream
        # timeout, for example) embed the raw request line and there is no
        # error-log redaction hook.  Silence gateway error messages for every
        # spelling that carries the marker, including a double-encoded byte
        # left as a bare ``%`` in ``$uri``; the application's own redacted log
        # still records failures.
        location ~* "artifact-downloads|%" {
            if (-f /srv/deployment/.maintenance) { return 503; }
            error_log /dev/null emerg;
            proxy_pass http://web:${UPSTREAM_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $origin_proto;
        }

        location = /maintenance.html {
            root /usr/share/nginx/html;
            internal;
            default_type text/html;
            add_header Retry-After 120 always;
        }

        # Tool calls share the /compute/api/tools/<name>/call transport with the
        # ordinary Task submission API but may opt into a larger multipart body.
        # The route sets Flask's per-request cap to TOOL_REQUEST_MAX_BYTES plus
        # 1 MiB of framing headroom, so this gateway value must be at least that
        # sum. Ordinary Task submissions keep the 16m http-level cap.
        location ~ ^/compute/api/tools/[^/]+/call$ {
            if (-f /srv/deployment/.maintenance) { return 503; }
            client_max_body_size ${TOOL_CLIENT_MAX_BODY_SIZE};
            proxy_pass http://web:${UPSTREAM_PORT};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $origin_proto;
        }

        # The agent MCP surface, when (and only when) the deployment opted in.
        # The controller writes SERVER_DIR/mcp-gateway/mcp.conf — already mounted
        # read-only at /srv/deployment — from MCP_ENABLED. When the directory is
        # absent the mask matches nothing and nginx includes an empty file list,
        # so /k/ is not a route at all rather than a route to a dead port. The
        # route carries no limiter of its own: MCP terminates in the same
        # application the HTTP API does, so one budget covers both.
        include /srv/deployment/mcp-gateway/*.conf;
    }
}
